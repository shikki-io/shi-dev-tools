#!/usr/bin/env bash
# Shikki brand-discipline pre-commit hook
# Per feedback_no-ai-slop-commit-pr-markers.md
# Installed by: shi agency (or manually from ~/.shikki/templates/git-hooks/)
set -e

MSG_FILE="$1"
[ -z "$MSG_FILE" ] && exit 0

# REJECT Claude/Anthropic attribution
if grep -qE 'Co-Authored-By:[[:space:]]+Claude|Co-Authored-By:[[:space:]]+Anthropic|🤖 Generated with \[Claude' "$MSG_FILE"; then
    echo "✗ shikki: forbidden Claude/Anthropic attribution detected. Remove and retry." >&2
    exit 1
fi

# AUTO-APPEND shikki-bot if no Co-Authored-By trailer exists
if ! grep -qE '^Co-Authored-By:' "$MSG_FILE"; then
    BOT_ID=$(jq -r '.bot_identity // "shikki-bot <bot@shikki.io>"' "$HOME/.shikki/identity.json" 2>/dev/null || echo "shikki-bot <bot@shikki.io>")
    echo "" >> "$MSG_FILE"
    echo "Co-Authored-By: $BOT_ID" >> "$MSG_FILE"
fi
